# Firebase Web API key for the selected environment
VITE_FIREBASE_API_KEY=
# Firebase Auth domain for the selected environment
VITE_FIREBASE_AUTH_DOMAIN=
# Firebase Realtime Database URL for the selected environment
VITE_FIREBASE_DATABASE_URL=
# Firebase project ID for the selected environment
VITE_FIREBASE_PROJECT_ID=
# Firebase Storage bucket for the selected environment
VITE_FIREBASE_STORAGE_BUCKET=
# Firebase Cloud Messaging sender ID for the selected environment
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Firebase app ID for the selected environment
VITE_FIREBASE_APP_ID=
# Set true for local emulator use, false for production Firebase services
VITE_USE_EMULATOR=
